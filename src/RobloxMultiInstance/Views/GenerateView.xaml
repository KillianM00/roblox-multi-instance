<UserControl x:Class="RobloxMultiInstance.Views.GenerateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RobloxMultiInstance.ViewModels">

    <UserControl.DataContext>
        <vm:GenerateViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Account Generator" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Spin up new Roblox accounts in the embedded browser. Roblox enforces a CAPTCHA on signup so you solve it once per account, then the cookie is captured automatically."
                       FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Suggested username -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="SUGGESTED USERNAME"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SuggestedUsername, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16" FontFamily="Consolas" />
                    <Button Grid.Column="1" Content="Regenerate" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RegenUsernameCommand}" />
                    <Button Grid.Column="2" Content="Copy" Margin="6,0,0,0"
                            Command="{Binding CopyUsernameCommand}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Suggested password -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="SUGGESTED PASSWORD"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SuggestedPassword, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16" FontFamily="Consolas" />
                    <Button Grid.Column="1" Content="Regenerate" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RegenPasswordCommand}" />
                    <Button Grid.Column="2" Content="Copy" Margin="6,0,0,0"
                            Command="{Binding CopyPasswordCommand}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Open signup -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="OPEN SIGNUP" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                <TextBlock Text="Launches an embedded browser at https://www.roblox.com/CreateAccount. Paste the username/password if you want, fill in birthday, solve the CAPTCHA. When Roblox lands you on the home page, the new account is auto-added with avatar + user ID."
                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10" />
                <Button Content="Open Signup Browser" HorizontalAlignment="Left"
                        Padding="14,7"
                        Command="{Binding OpenSignupCommand}" />
            </StackPanel>
        </Border>

        <!-- Status -->
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="STATUS / TIPS" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}" FontSize="12" />
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                           Text="• Roblox flags rapid signups from one IP. Switch your VPN exit on the Network tab between signups." />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                           Text="• Each new account needs a unique birthday/email to avoid pattern detection. Roblox doesn't strictly require email but lots of features are gated behind it." />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                           Text="• Cookies for fresh accounts may rotate aggressively in the first hour — the validity monitor will pick that up." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
