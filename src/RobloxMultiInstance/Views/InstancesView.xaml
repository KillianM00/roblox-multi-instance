<UserControl x:Class="RobloxMultiInstance.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RobloxMultiInstance.ViewModels"
             xmlns:ctl="clr-namespace:RobloxMultiInstance.Controls">

    <UserControl.DataContext>
        <vm:InstancesViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:InstanceTileViewModel}">
            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="6"
                    Padding="0"
                    SnapsToDevicePixels="True">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="Black" CornerRadius="8,8,0,0" ClipToBounds="True">
                        <Grid>
                            <ctl:DwmThumbnailHost SourceHwnd="{Binding Hwnd}" />
                            <Border Background="#88000000" VerticalAlignment="Top" HorizontalAlignment="Right"
                                    Margin="8" CornerRadius="4" Padding="6,2"
                                    Visibility="{Binding HasHwnd, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="Loading window..." Foreground="White" FontSize="11" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Padding="12,10" Background="{StaticResource PanelBrush}" CornerRadius="0,0,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="13"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding WindowTitle}" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Focus" Padding="10,4"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding FocusCommand}" />
                                <Button Content="Play Here" Padding="10,4" Margin="6,0,0,0"
                                        Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Live Instances" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Double-click a tile to play inside it." FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        Visibility="{Binding IsPlayMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Button Content="Arrange on Desktop" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ArrangeOnDesktopCommand}" />
                <Button Content="Minimize All" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                        Command="{Binding MinimizeAllCommand}" />
            </StackPanel>
            <Button Grid.Column="1" Content="← Back to Grid"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding BackToGridCommand}"
                    Visibility="{Binding IsPlayMode, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <!-- Grid view -->
        <Grid Grid.Row="1" Visibility="{Binding IsPlayMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Tiles.Count, Converter={StaticResource IntToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="40,30"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Tiles.Count, Converter={StaticResource IntToInverseVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="No Roblox instances yet"
                               FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Go to the Accounts tab, select accounts, and click Launch Selected."
                               FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Play mode: large play area + sidebar -->
        <Grid Grid.Row="1" Visibility="{Binding IsPlayMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="Black"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                    CornerRadius="8" Margin="0,0,8,0"
                    x:Name="PlayAreaBorder">
                <Grid x:Name="PlayArea">
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Roblox is now positioned over this area. Click to play." />
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="10">
                <StackPanel>
                    <TextBlock Text="OTHER INSTANCES" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" Margin="2,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:InstanceTileViewModel}">
                                <Border Background="{StaticResource PanelAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Margin="0,0,0,8" Padding="6">
                                    <StackPanel>
                                        <Border Height="100" Background="Black" CornerRadius="4" ClipToBounds="True">
                                            <ctl:DwmThumbnailHost SourceHwnd="{Binding Hwnd}" />
                                        </Border>
                                        <TextBlock Text="{Binding Alias}" FontSize="11" Margin="2,6,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Content="Switch"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="6,3" Margin="0,4,0,0" FontSize="11"
                                                Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,8,0,0">
            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding StatusText}" />
        </Border>
    </Grid>
</UserControl>
