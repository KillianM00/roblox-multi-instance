<Window x:Class="RobloxMultiInstance.Views.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="600" Height="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Text="Alias (display name in the list)"
                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
        <TextBox Grid.Row="2" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"
                       Text=".ROBLOSECURITY cookie (paste the entire value)" />
            <TextBox Grid.Row="1" Text="{Binding Cookie, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="11" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Validate" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ValidateCommand}" IsEnabled="{Binding IsValidating, Converter={StaticResource InverseBoolConverter}}" />
            <TextBlock Text="{Binding ValidateStatus}" VerticalAlignment="Center"
                       Margin="12,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <TextBlock Grid.Row="5" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11"
                   Margin="0,4,0,12">
            Cookies are encrypted on disk using Windows DPAPI (only your Windows user can decrypt them).
            To get a cookie: log into roblox.com in a browser, open DevTools (F12) &#x2192; Application &#x2192; Cookies &#x2192;
            copy the value of .ROBLOSECURITY.
        </TextBlock>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="Save" Margin="8,0,0,0"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>
    </Grid>
</Window>
