<Window x:Class="RobloxMultiInstance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RobloxMultiInstance.ViewModels"
        xmlns:views="clr-namespace:RobloxMultiInstance.Views"
        Title="Multi Roblox Manager"
        Width="1180" Height="720"
        MinWidth="900" MinHeight="540"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo / title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6"
                            Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock Text="R" Foreground="White" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Multi Roblox" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Text="Manager" FontSize="16"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>

                <!-- Nav tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Accounts"
                            Command="{Binding GoToAccountsCommand}"
                            Padding="18,7" Margin="0,0,6,0"
                            Background="{Binding CurrentTab, Converter={StaticResource TabSelectedToBrushConverter}, ConverterParameter=Accounts}"
                            Foreground="{Binding CurrentTab, Converter={StaticResource TabSelectedToForegroundConverter}, ConverterParameter=Accounts}"
                            BorderThickness="0" />
                    <Button Content="Instances"
                            Command="{Binding GoToInstancesCommand}"
                            Padding="18,7" Margin="0,0,6,0"
                            Background="{Binding CurrentTab, Converter={StaticResource TabSelectedToBrushConverter}, ConverterParameter=Instances}"
                            Foreground="{Binding CurrentTab, Converter={StaticResource TabSelectedToForegroundConverter}, ConverterParameter=Instances}"
                            BorderThickness="0" />
                    <Button Content="Network"
                            Command="{Binding GoToNetworkCommand}"
                            Padding="18,7" Margin="0,0,6,0"
                            Background="{Binding CurrentTab, Converter={StaticResource TabSelectedToBrushConverter}, ConverterParameter=Network}"
                            Foreground="{Binding CurrentTab, Converter={StaticResource TabSelectedToForegroundConverter}, ConverterParameter=Network}"
                            BorderThickness="0" />
                    <Button Content="Generate"
                            Command="{Binding GoToGenerateCommand}"
                            Padding="18,7"
                            Background="{Binding CurrentTab, Converter={StaticResource TabSelectedToBrushConverter}, ConverterParameter=Generate}"
                            Foreground="{Binding CurrentTab, Converter={StaticResource TabSelectedToForegroundConverter}, ConverterParameter=Generate}"
                            BorderThickness="0" />
                </StackPanel>

                <!-- Mutex pill -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                             Fill="{Binding MutexHeld, Converter={StaticResource BoolToBrushConverter}}" />
                    <TextBlock Text="{Binding MutexHeld, Converter={StaticResource BoolToMutexTextConverter}}"
                               FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="20">
            <views:AccountsView Visibility="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Accounts}" />
            <views:InstancesView Visibility="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Instances}" />
            <views:NetworkView Visibility="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Network}" />
            <views:GenerateView Visibility="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Generate}" />
        </Grid>
    </Grid>
</Window>
